generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType { SOLAR WIND HYDRO BATTERY BIOMASS GRID }
enum AssetStatus { ACTIVE MAINTENANCE OFFLINE COMMISSIONING }
enum TelemetryQuality { GOOD ESTIMATED BAD }

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  assets    EnergyAsset[]
  memberships Membership[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("organizations")
}

model EnergyAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           AssetType
  status         AssetStatus  @default(ACTIVE)
  capacityMw     Decimal      @db.Decimal(12, 3) @map("capacity_mw")
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  metadata       Json         @default("{}")
  telemetry      Telemetry[]
  connectedDevices ConnectedDevice[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  @@index([organizationId, status])
  @@map("energy_assets")
}

model Telemetry {
  id         BigInt           @id @default(autoincrement())
  assetId    String           @db.Uuid @map("asset_id")
  asset      EnergyAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  metric     String
  value      Decimal          @db.Decimal(20, 6)
  unit       String
  quality    TelemetryQuality @default(GOOD)
  recordedAt DateTime         @map("recorded_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  @@index([assetId, metric, recordedAt(sort: Desc)])
  @@map("telemetry")
}

model ExchangeOrder {
  id             String   @id
  organizationId String
  commodity      String
  side           String
  quantity       Decimal  @db.Decimal(24, 8)
  limitPrice     Decimal  @db.Decimal(24, 8)
  currency       String
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("exchange_orders")
}

model Partnership {
  id             String   @id
  organizationId String
  slug           String
  partnerName    String
  category       String
  status         String   @default("prospect")
  ownerId        String
  createdAt      DateTime @default(now())

  @@unique([organizationId, slug])
  @@map("partnerships")
}

enum MembershipRole { CONSUMER PROSUMER CLIENT COMPANY ADMIN SUPER_ADMIN }
enum ChatRole { USER ASSISTANT SYSTEM }

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  displayName String       @map("display_name")
  memberships Membership[]
  chats       AIChat[]
  savedCopilotPrompts CopilotSavedPrompt[]
  copilotFeedback CopilotMessageFeedback[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  @@map("users")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid @map("user_id")
  organizationId String         @db.Uuid @map("organization_id")
  role           MembershipRole @default(CONSUMER)
  tierId         String         @default("starter") @map("tier_id")
  user           User           @relation(fields:[userId],references:[id],onDelete:Cascade)
  organization   Organization   @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt      DateTime       @default(now()) @map("created_at")
  @@unique([userId,organizationId])
  @@index([organizationId,role])
  @@map("memberships")
}

model AIChat {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid @map("user_id")
  title     String
  modelId   String      @map("model_id")
  user      User        @relation(fields:[userId],references:[id],onDelete:Cascade)
  messages  AIMessage[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  @@index([userId,updatedAt(sort:Desc)])
  @@map("ai_chats")
}

model AIMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid @map("chat_id")
  userId    String   @db.Uuid @map("user_id")
  role      ChatRole
  content   String
  metadata  Json     @default("{}")
  chat      AIChat   @relation(fields:[chatId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([chatId,createdAt])
  @@map("ai_messages")
}

enum P2PListingMode { BUY SELL RENT }
enum P2POrderStatus { PENDING_SIGNATURE OPEN MATCHED SETTLED CANCELLED }

model P2PEnergyListing {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid @map("organization_id")
  mode           P2PListingMode
  source         String
  location       String
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  quantityKwh    Decimal        @db.Decimal(18, 6) @map("quantity_kwh")
  availableKwh   Decimal        @db.Decimal(18, 6) @map("available_kwh")
  pricePerKwh    Decimal        @db.Decimal(18, 8) @map("price_per_kwh")
  currency       String         @default("EUR")
  deliveryStart  DateTime       @map("delivery_start")
  deliveryEnd    DateTime       @map("delivery_end")
  metadata       Json           @default("{}")
  orders         P2PEnergyOrder[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  @@index([mode, deliveryStart])
  @@map("p2p_energy_listings")
}

model P2PEnergyOrder {
  id            String         @id @default(uuid()) @db.Uuid
  listingId     String         @db.Uuid @map("listing_id")
  buyerId       String         @db.Uuid @map("buyer_id")
  quantityKwh   Decimal        @db.Decimal(18, 6) @map("quantity_kwh")
  totalAmount   Decimal        @db.Decimal(18, 8) @map("total_amount")
  walletAddress String?        @map("wallet_address")
  signature     String?
  status        P2POrderStatus @default(PENDING_SIGNATURE)
  listing       P2PEnergyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  @@index([buyerId, status])
  @@map("p2p_energy_orders")
}


model ConnectedDevice {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid @map("organization_id")
  assetId            String?  @db.Uuid @map("asset_id")
  deviceId           String   @map("device_id")
  kind               String
  manufacturer       String
  model              String
  firmware           String?
  serialNumber       String?  @map("serial_number")
  status             String   @default("UNCONFIGURED")
  network            String
  healthScore        Int      @default(0) @map("health_score")
  currentOutputW     BigInt?  @map("current_output_w")
  cumulativeEnergyWh BigInt?  @map("cumulative_energy_wh")
  lastSeenAt         DateTime? @map("last_seen_at")
  version            Int      @default(1)
  metadata           Json     @default("{}")
  asset              EnergyAsset? @relation(fields:[assetId],references:[id],onDelete:SetNull)
  telemetry          DeviceTelemetry[]
  commands           DeviceCommand[]
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  @@unique([organizationId,deviceId])
  @@index([organizationId,status])
  @@index([assetId])
  @@map("connected_devices")
}

model DeviceTelemetry {
  id          BigInt          @id @default(autoincrement())
  deviceId    String          @db.Uuid @map("device_id")
  device      ConnectedDevice @relation(fields:[deviceId],references:[id],onDelete:Cascade)
  metric      String
  value       Decimal         @db.Decimal(24,6)
  unit        String
  quality     String          @default("GOOD")
  recordedAt  DateTime        @map("recorded_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  @@index([deviceId,metric,recordedAt(sort:Desc)])
  @@map("device_telemetry")
}

model DeviceCommand {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid @map("organization_id")
  deviceId              String          @db.Uuid @map("device_id")
  commandType           String          @map("command_type")
  expectedDeviceVersion Int             @map("expected_device_version")
  state                 String          @default("REVIEW_REQUIRED")
  reason                String
  requestedBy           String          @map("requested_by")
  idempotencyKey        String          @map("idempotency_key")
  approvedBy            String?         @map("approved_by")
  requestId             String          @map("request_id")
  traceId               String          @map("trace_id")
  correlationId         String          @map("correlation_id")
  externalReference     String?         @map("external_reference")
  device                ConnectedDevice @relation(fields:[deviceId],references:[id],onDelete:Cascade)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,state,createdAt(sort:Desc)])
  @@map("device_commands")
}

model CopilotSavedPrompt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  promptId  String   @map("prompt_id")
  user      User     @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId,promptId])
  @@map("copilot_saved_prompts")
}

model CopilotMessageFeedback {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @db.Uuid @map("message_id")
  userId    String    @db.Uuid @map("user_id")
  value     String
  reason    String?
  user      User      @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  @@unique([messageId,userId])
  @@index([userId,createdAt(sort:Desc)])
  @@map("copilot_message_feedback")
}

model AcpProviderDirectory {
  id                  String   @id
  organizationId      String?  @map("organization_id")
  publicId            String   @unique @map("public_id")
  name                String
  participantType     String   @map("participant_type")
  walletAddress       String   @map("wallet_address")
  identityHash        String   @map("identity_hash")
  apiEndpoint         String   @map("api_endpoint")
  eventEndpoint       String?  @map("event_endpoint")
  credentialReference String?  @map("credential_reference")
  status              String   @default("active")
  capabilities        String[] @default([])
  offerings           Json     @default("[]")
  chains              Int[]    @default([])
  categories          String[] @default([])
  regions             String[] @default([])
  successfulJobs      Int      @default(0) @map("successful_jobs")
  successRate         Decimal? @db.Decimal(6,3) @map("success_rate")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  @@index([status,participantType,name])
  @@map("acp_provider_directory")
}

model EnergyNetworkParticipant {
  id              String   @id
  organizationId  String?  @map("organization_id")
  publicId        String   @unique @map("public_id")
  name            String
  participantType String   @map("participant_type")
  country         String
  region          String?
  latitude        Decimal? @db.Decimal(9,6)
  longitude       Decimal? @db.Decimal(9,6)
  capabilities    String[] @default([])
  energySources   String[] @default([]) @map("energy_sources")
  markets         String[] @default([])
  verified        Boolean  @default(false)
  publicProfile   Boolean  @default(false) @map("public_profile")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@index([publicProfile,participantType,country,region])
  @@map("energy_network_participants")
}

model CopilotCreditAccount {
  id              String   @id
  organizationId  String   @db.Uuid @map("organization_id")
  userId          String   @db.Uuid @map("user_id")
  balancePwrcRaw  Decimal  @default(0) @db.Decimal(78,0) @map("balance_pwrc_raw")
  reservedPwrcRaw Decimal  @default(0) @db.Decimal(78,0) @map("reserved_pwrc_raw")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@unique([organizationId,userId])
  @@map("copilot_credit_accounts")
}

model CopilotCreditLedgerEntry {
  id                String   @id
  organizationId    String   @db.Uuid @map("organization_id")
  accountId         String   @map("account_id")
  entryType         String   @map("entry_type")
  pwrcRaw           Decimal  @db.Decimal(78,0) @map("pwrc_raw")
  direction         String
  requestId         String?  @map("request_id")
  quoteId           String?  @map("quote_id")
  reservationId     String?  @map("reservation_id")
  externalReference String?  @map("external_reference")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  @@index([accountId,createdAt(sort:Desc)])
  @@map("copilot_credit_ledger_entries")
}

model CopilotCreditReservation {
  id              String   @id
  organizationId  String   @db.Uuid @map("organization_id")
  accountId       String   @map("account_id")
  requestId       String   @map("request_id")
  quoteId         String   @map("quote_id")
  pricingClass    String   @map("pricing_class")
  usdCharge       Decimal  @db.Decimal(12,6) @map("usd_charge")
  pwrcUsdPrice    Decimal  @db.Decimal(24,12) @map("pwrc_usd_price")
  reservedPwrcRaw Decimal  @db.Decimal(78,0) @map("reserved_pwrc_raw")
  settledPwrcRaw  Decimal  @default(0) @db.Decimal(78,0) @map("settled_pwrc_raw")
  state           String   @default("reserved")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  settledAt       DateTime? @map("settled_at")
  @@unique([organizationId,requestId])
  @@index([state,expiresAt])
  @@map("copilot_credit_reservations")
}

model VaultRecord {
  id              String   @id
  organizationId  String   @map("organization_id")
  classification  String
  contentHash     String   @map("content_hash")
  storageReference String  @map("storage_reference")
  retentionPolicy String   @map("retention_policy")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  @@unique([organizationId,contentHash,storageReference])
  @@map("vault_records")
}

model RewardAllocation {
  id             String   @id
  organizationId String   @map("organization_id")
  participantId  String   @map("participant_id")
  epoch           String
  reason          String
  pwrcRaw         Decimal  @db.Decimal(78,0) @map("pwrc_raw")
  evidenceIds     String[] @default([]) @map("evidence_ids")
  state           String   @default("PENDING")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@unique([organizationId,participantId,epoch,reason])
  @@map("reward_allocations")
}

model ErpDocument {
  id                String   @id
  organizationId    String   @map("organization_id")
  documentType      String   @map("document_type")
  externalReference String?  @map("external_reference")
  counterpartyId    String?  @map("counterparty_id")
  currency          String
  amountMinor       Decimal  @db.Decimal(78,0) @map("amount_minor")
  status             String
  sourceSystem       String   @map("source_system")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  @@index([organizationId,status,createdAt(sort:Desc)])
  @@map("erp_documents")
}

model CmrRelationship {
  id               String   @id
  organizationId   String   @map("organization_id")
  participantId    String   @map("participant_id")
  relationshipType String   @map("relationship_type")
  status            String
  ownerId           String?  @map("owner_id")
  tags              String[] @default([])
  consents          String[] @default([])
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  @@unique([organizationId,participantId,relationshipType])
  @@map("cmr_relationships")
}

model CmrInteraction {
  id             String   @id
  organizationId String   @map("organization_id")
  relationshipId String   @map("relationship_id")
  channel        String
  summary        String
  occurredAt     DateTime @map("occurred_at")
  actorId        String   @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  @@index([organizationId,relationshipId,occurredAt(sort:Desc)])
  @@map("cmr_interactions")
}

model LocalEnergyListing {
  id               String   @id
  organizationId   String   @db.Uuid @map("organization_id")
  participantId    String   @map("participant_id")
  mode             String
  source           String
  assetId          String?  @map("asset_id")
  quantityWh       BigInt   @map("quantity_wh")
  availableWh      BigInt   @map("available_wh")
  priceMinorPerKwh BigInt   @map("price_minor_per_kwh")
  currency         String
  deliveryStart    DateTime @map("delivery_start")
  deliveryEnd      DateTime @map("delivery_end")
  state            String   @default("ACTIVE")
  version          Int      @default(1)
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  reservations     LocalEnergyReservation[]
  @@index([mode,state,deliveryStart])
  @@index([organizationId,updatedAt(sort:Desc)])
  @@map("local_energy_listings")
}

model LocalEnergyReservation {
  id                          String   @id
  organizationId              String   @db.Uuid @map("organization_id")
  listingId                   String   @map("listing_id")
  counterpartyParticipantId   String   @map("counterparty_participant_id")
  quantityWh                  BigInt   @map("quantity_wh")
  listingVersion              Int      @map("listing_version")
  state                       String   @default("REVIEW_REQUIRED")
  idempotencyKey              String   @map("idempotency_key")
  deliveryEvidenceId          String?  @map("delivery_evidence_id")
  reconciliationReference     String?  @map("reconciliation_reference")
  externalSettlementReference String? @map("external_settlement_reference")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  listing                     LocalEnergyListing @relation(fields:[listingId],references:[id],onDelete:Restrict)
  @@unique([organizationId,idempotencyKey])
  @@index([listingId,state,createdAt(sort:Desc)])
  @@index([organizationId,state,updatedAt(sort:Desc)])
  @@map("local_energy_reservations")
}

model TreasuryAccount {
  id             String   @id
  organizationId String   @db.Uuid @map("organization_id")
  code           String
  name           String
  accountType    String   @map("account_type")
  asset          String
  balanceRaw     Decimal  @default(0) @db.Decimal(78,0) @map("balance_raw")
  status         String   @default("ACTIVE")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  postings       TreasuryPosting[]
  @@unique([organizationId,code,asset])
  @@index([organizationId,accountType,status])
  @@map("treasury_accounts")
}

model TreasuryJournal {
  id                 String   @id
  organizationId     String   @db.Uuid @map("organization_id")
  businessReference  String   @map("business_reference")
  journalType        String   @map("journal_type")
  sourceJournalId    String?  @map("source_journal_id")
  reason             String?
  requestId          String   @map("request_id")
  traceId            String   @map("trace_id")
  correlationId      String   @map("correlation_id")
  policyHash         String?  @map("policy_hash")
  postedAt           DateTime @default(now()) @map("posted_at")
  postings           TreasuryPosting[]
  @@unique([organizationId,businessReference])
  @@index([organizationId,postedAt(sort:Desc)])
  @@map("treasury_journals")
}

model TreasuryPosting {
  id             String          @id
  organizationId String          @db.Uuid @map("organization_id")
  journalId      String          @map("journal_id")
  accountId      String          @map("account_id")
  asset          String
  amountRaw      Decimal         @db.Decimal(78,0) @map("amount_raw")
  direction      String
  createdAt      DateTime        @default(now()) @map("created_at")
  journal        TreasuryJournal @relation(fields:[journalId],references:[id],onDelete:Restrict)
  account        TreasuryAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  @@index([organizationId,journalId])
  @@index([organizationId,accountId,createdAt(sort:Desc)])
  @@map("treasury_postings")
}

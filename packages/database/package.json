{
  "name": "@powerchain/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./clients/supabase": "./src/clients/supabase/index.ts",
    "./clients/*": "./src/clients/*.ts",
    "./operations": "./src/repositories/operations.ts",
    "./tokenized-chat": "./src/repositories/tokenized-chat.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@powerchain/configuration": "workspace:*",
    "@powerchain/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "pg": "8.23.0",
    "@powerchain/local-energy": "workspace:*",
    "@powerchain/energy-network": "workspace:*",
    "@powerchain/credits": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "6.19.3"
  },
  "peerDependencies": {
    "next": "^16.2.12"
  }
}

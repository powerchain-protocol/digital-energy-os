{
  "name": "@powerchain/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./clients/supabase": "./src/clients/supabase/index.ts",
    "./clients/*": "./src/clients/*.ts",
    "./acp": "./src/repositories/acp.ts",
    "./realtime": "./src/repositories/realtime.ts",
    "./energy-monitoring": "./src/repositories/energy-monitoring.ts",
    "./copilot": "./src/repositories/copilot.ts",
    "./acp-provider-network": "./src/repositories/acp-provider-network.ts",
    "./copilot-credits": "./src/repositories/copilot-credits.ts",
    "./energy-network": "./src/repositories/energy-network.ts",
    "./local-energy": "./src/repositories/local-energy.ts",
    "./operator-workspaces": "./src/repositories/operator-workspaces.ts",
    "./asset-graph": "./src/repositories/asset-graph.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@powerchain/configuration": "workspace:*",
    "@powerchain/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "pg": "8.23.0",
    "@powerchain/acp-contracts": "workspace:*",
    "@powerchain/energy-monitoring": "workspace:*",
    "@powerchain/credits": "workspace:*",
    "@powerchain/energy-network": "workspace:*",
    "@powerchain/local-energy": "workspace:*",
    "@powerchain/asset-graph": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "6.19.3"
  },
  "peerDependencies": {
    "next": "^16.2.12"
  }
}

{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["dom", "dom.iterable", "es2024"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@powerchain/ai-core": ["./packages/ai-core/src/index.ts"],
      "@powerchain/ai-gateway": ["./packages/ai-gateway/src/index.ts"],
      "@powerchain/ai-ui": ["./packages/ai-ui/src/index.ts"],
      "@powerchain/contracts": ["./packages/contracts/src/index.ts"],
      "@powerchain/credits": ["./packages/credits/src/index.ts"],
      "@powerchain/integration": ["./packages/integration/src/index.ts"],
      "@powerchain/integration/*": ["./packages/integration/src/*/index.ts"],
      "@powerchain/shared": ["./packages/shared/src/index.ts"]
    },
    "plugins": [{"name": "next"}]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "proxy.ts",
    "next.config.ts",
    "tailwind.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "src/**/*.stories.tsx",
    "tests/e2e",
    "playwright.config.ts",
    ".storybook"
  ]
}

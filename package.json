{
  "name": "powerchain-platform",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "PowerChain Renewable Energy Operating System (PowerChain REOS) is a decentralized platform for managing renewable energy assets and transactions.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "node scripts/check-imports.mjs && node scripts/format-check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "prisma studio",
    "env:check": "node scripts/check-env.mjs",
    "format:check": "node scripts/format-check.mjs",
    "validate": "pnpm env:check && pnpm config:check && pnpm check:structure && pnpm check:routing && pnpm imports:check && pnpm schema:check && pnpm programs:check && pnpm contracts:check && pnpm openapi:check && pnpm test:smoke && pnpm migrations:check && pnpm architecture:check && pnpm ptsp:check && pnpm framework:check && pnpm docs:check",
    "test:smoke": "node --test tests/*.test.mjs",
    "test:breakpoints": "node --test tests/breakpoints.test.mjs",
    "test:e2e": "playwright test",
    "storybook": "pnpm --filter @powerchain/storybook dev",
    "build-storybook": "pnpm --filter @powerchain/storybook build",
    "openapi:check": "node scripts/check-openapi.mjs",
    "docker:build": "docker build -t powerchain-platform:mvp",
    "clean": "node scripts/clean.mjs",
    "verify": "pnpm validate && pnpm typecheck && pnpm build",
    "migrations:check": "node scripts/check-migrations.mjs",
    "check:routing": "node scripts/check-routing.mjs",
    "prebuild": "node scripts/fix-postcss.mjs && node scripts/check-postcss.mjs && pnpm check:routing",
    "schema:check": "node scripts/check-schema.mjs",
    "programs:check": "node scripts/check-programs.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "config:check": "node scripts/check-config.mjs",
    "imports:check": "node scripts/check-imports.mjs",
    "deps:approve": "pnpm approve-builds",
    "deps:install": "pnpm install",
    "deps:update": "pnpm update --interactive --latest",
    "deps:install:locked": "pnpm install --frozen-lockfile",
    "deps:policy": "pnpm config get minimumReleaseAge",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "install:frozen": "pnpm install --frozen-lockfile",
    "ci:install": "pnpm install --frozen-lockfile",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium",
    "programs:test": "node --test tests/programs.test.mjs",
    "networks:test": "node --test tests/networks.test.mjs",
    "migration:status": "node scripts/migration-status.mjs",
    "supabase:types": "supabase gen types typescript --local > src/types/database/supabase.ts",
    "test:unit": "node --test tests/*.test.mjs",
    "predev": "node scripts/clean-next.mjs && node scripts/fix-postcss.mjs && node scripts/check-postcss.mjs",
    "css:check": "node scripts/check-postcss.mjs",
    "deps:rebuild": "pnpm rebuild @prisma/client @prisma/engines prisma bufferutil utf-8-validate protobufjs bigint-buffer blake-hash tiny-secp256k1",
    "doctor": "pnpm css:check && pnpm env:check && pnpm config:check && pnpm imports:check && pnpm check:routing",
    "css:fix": "node scripts/fix-postcss.mjs",
    "ecosystem:test": "node --test tests/ecosystem.test.mjs",
    "platform:test": "node --test tests/platform-architecture.test.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "ptsp:check": "node scripts/check-ptsp.mjs",
    "framework:check": "node scripts/check-framework.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "dev:fast": "next dev",
    "transactions:test": "node --test tests/transactions.test.mjs",
    "telemetry:disable": "next telemetry disable",
    "workers:test": "node --test tests/workers.test.mjs",
    "docs:dev": "pnpm --filter @powerchain/docs dev",
    "docs:build": "pnpm --filter @powerchain/docs build",
    "integration:test": "node --test packages/integration/tests/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "workspace:list": "pnpm -r list --depth -1",
    "workspace:typecheck": "pnpm -r --if-present typecheck",
    "monorepo:check": "node scripts/check-monorepo.mjs"
  },
  "dependencies": {
    "@cetusprotocol/cetus-sui-clmm-sdk": "^5.4.0",
    "@mysten/sui": "^2.26.2",
    "@neondatabase/serverless": "^1.1.0",
    "@powerchain/ai-core": "workspace:*",
    "@powerchain/ai-gateway": "workspace:*",
    "@powerchain/ai-ui": "workspace:*",
    "@powerchain/contracts": "workspace:*",
    "@powerchain/credits": "workspace:*",
    "@powerchain/integration": "workspace:*",
    "@powerchain/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@solana/pay": "^1.0.26",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/wallet-standard-wallet-adapter-react": "^1.1.6",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "@web3icons/react": "^4.1.21",
    "axios": "^1.19.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "helius-sdk": "^2.2.2",
    "lucide-react": "^1.33.0",
    "next": "16.2.12",
    "pino": "^9.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/nextjs": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "10.8.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@coral-xyz/anchor": "^0.32.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <27",
    "pnpm": "11.22.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType { SOLAR WIND HYDRO BATTERY BIOMASS GRID }
enum AssetStatus { ACTIVE MAINTENANCE OFFLINE COMMISSIONING }
enum TelemetryQuality { GOOD ESTIMATED BAD }

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  assets    EnergyAsset[]
  memberships Membership[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("organizations")
}

model EnergyAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           AssetType
  status         AssetStatus  @default(ACTIVE)
  capacityMw     Decimal      @db.Decimal(12, 3) @map("capacity_mw")
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  metadata       Json         @default("{}")
  telemetry      Telemetry[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  @@index([organizationId, status])
  @@map("energy_assets")
}

model Telemetry {
  id         BigInt           @id @default(autoincrement())
  assetId    String           @db.Uuid @map("asset_id")
  asset      EnergyAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  metric     String
  value      Decimal          @db.Decimal(20, 6)
  unit       String
  quality    TelemetryQuality @default(GOOD)
  recordedAt DateTime         @map("recorded_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  @@index([assetId, metric, recordedAt(sort: Desc)])
  @@map("telemetry")
}

model ExchangeOrder {
  id             String   @id
  organizationId String
  commodity      String
  side           String
  quantity       Decimal  @db.Decimal(24, 8)
  limitPrice     Decimal  @db.Decimal(24, 8)
  currency       String
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("exchange_orders")
}

model Partnership {
  id             String   @id
  organizationId String
  slug           String
  partnerName    String
  category       String
  status         String   @default("prospect")
  ownerId        String
  createdAt      DateTime @default(now())

  @@unique([organizationId, slug])
  @@map("partnerships")
}

enum MembershipRole { CONSUMER PROSUMER CLIENT COMPANY ADMIN SUPER_ADMIN }
enum ChatRole { USER ASSISTANT SYSTEM }

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  displayName String       @map("display_name")
  memberships Membership[]
  chats       AIChat[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  @@map("users")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid @map("user_id")
  organizationId String         @db.Uuid @map("organization_id")
  role           MembershipRole @default(CONSUMER)
  tierId         String         @default("starter") @map("tier_id")
  user           User           @relation(fields:[userId],references:[id],onDelete:Cascade)
  organization   Organization   @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt      DateTime       @default(now()) @map("created_at")
  @@unique([userId,organizationId])
  @@index([organizationId,role])
  @@map("memberships")
}

model AIChat {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid @map("user_id")
  title     String
  modelId   String      @map("model_id")
  user      User        @relation(fields:[userId],references:[id],onDelete:Cascade)
  messages  AIMessage[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  @@index([userId,updatedAt(sort:Desc)])
  @@map("ai_chats")
}

model AIMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid @map("chat_id")
  userId    String   @db.Uuid @map("user_id")
  role      ChatRole
  content   String
  metadata  Json     @default("{}")
  chat      AIChat   @relation(fields:[chatId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([chatId,createdAt])
  @@map("ai_messages")
}

enum P2PListingMode { BUY SELL RENT }
enum P2POrderStatus { PENDING_SIGNATURE OPEN MATCHED SETTLED CANCELLED }

model P2PEnergyListing {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid @map("organization_id")
  mode           P2PListingMode
  source         String
  location       String
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  quantityKwh    Decimal        @db.Decimal(18, 6) @map("quantity_kwh")
  availableKwh   Decimal        @db.Decimal(18, 6) @map("available_kwh")
  pricePerKwh    Decimal        @db.Decimal(18, 8) @map("price_per_kwh")
  currency       String         @default("EUR")
  deliveryStart  DateTime       @map("delivery_start")
  deliveryEnd    DateTime       @map("delivery_end")
  metadata       Json           @default("{}")
  orders         P2PEnergyOrder[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  @@index([mode, deliveryStart])
  @@map("p2p_energy_listings")
}

model P2PEnergyOrder {
  id            String         @id @default(uuid()) @db.Uuid
  listingId     String         @db.Uuid @map("listing_id")
  buyerId       String         @db.Uuid @map("buyer_id")
  quantityKwh   Decimal        @db.Decimal(18, 6) @map("quantity_kwh")
  totalAmount   Decimal        @db.Decimal(18, 8) @map("total_amount")
  walletAddress String?        @map("wallet_address")
  signature     String?
  status        P2POrderStatus @default(PENDING_SIGNATURE)
  listing       P2PEnergyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  @@index([buyerId, status])
  @@map("p2p_energy_orders")
}
